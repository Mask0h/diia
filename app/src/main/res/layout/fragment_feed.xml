<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:ap="http://schemas.android.com/tools"
    android:background="@drawable/bg_gradient_2"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Привіт, Олексій 👋"
            android:textColor="#000000"
            android:textSize="28sp"
            android:fontFamily="@font/e_ukraine_bold"
            android:layout_marginBottom="20dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#80FFFFFF"
            app:cardElevation="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_nezlam_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Незламність"
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:fontFamily="@font/e_ukraine_bold" />

                <TextView
                    android:id="@+id/tv_nezlam_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_nezlam_title"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="48dp"
                    android:text="Мапа укриттів, Пунктів незламності та відділень Power Banking.\nЗаява про відсутній зв'язок."
                    android:textColor="#4A4A4A"
                    android:textSize="14sp"
                    android:fontFamily="@font/e_ukraine_regular" />

                <LinearLayout
                    android:id="@+id/ll_icons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_nezlam_desc"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_documents"
                        android:background="#0057B8"
                        android:padding="4dp"
                        android:contentDescription="@null" />

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_service"
                        android:background="#FFD700"
                        android:padding="4dp"
                        android:contentDescription="@null" />

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_menu"
                        android:background="#6B8E6B"
                        android:padding="4dp"
                        android:contentDescription="@null" />
                </LinearLayout>

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_below="@id/tv_nezlam_desc"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="8dp"
                    android:src="@drawable/ic_arrow"
                    android:backgroundTint="#000000"
                    android:padding="5dp"
                    android:contentDescription="@null"
                    android:background="@color/black"
                    app:tint="@color/white"
                    app:shapeAppearanceOverlay="@style/RoundedButton" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#1A1A1A"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_qr_code"
                        android:tint="@color/white"
                        android:contentDescription="@null" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Дія\nСканер"
                    android:gravity="center"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:fontFamily="@font/e_ukraine_regular" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#1A1A1A"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_service"
                        android:tint="@color/white"
                        android:contentDescription="@null" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Військові\nоблігації"
                    android:gravity="center"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:fontFamily="@font/e_ukraine_regular" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#1A1A1A"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_signal"
                        android:tint="@color/white"
                        android:contentDescription="@null" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Відсутній\nзв'язок"
                    android:gravity="center"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:fontFamily="@font/e_ukraine_regular" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Що нового?"
            android:textColor="#000000"
            android:textSize="20sp"
            android:fontFamily="@font/e_ukraine_bold"
            android:layout_marginBottom="12dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#CCCCCC">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:background="#88000000"
                    android:padding="12dp"
                    android:text="Актуальні новини"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/e_ukraine_regular" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>